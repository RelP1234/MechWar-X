battle_garage:R_garage_id:e -> pit_crew_technician:L_garage_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="1 : 0..N"];
client:R_client_id:e -> deployment_manifest:L_client_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="1 : 0..N"];
client:R_client_id:e -> maintenance_log:L_reporting_client_id:w [dir=both,arrowtail=odottee,arrowhead=crowodot,label="0..1 : 0..N"];

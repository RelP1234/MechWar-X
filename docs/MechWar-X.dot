digraph ERD {
 graph [rankdir=LR,splines=polyline,nodesep=0.65,ranksep=1.2,bgcolor="white",pad=0.35];
 node [shape=plain,fontname="Arial",fontsize=11];
 edge [fontname="Arial",fontsize=10,color="#557486",fontcolor="#294356",penwidth=1.2,arrowsize=0.7];
battle_garage [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>battle_garage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_garage_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">garage_id</TD><TD ALIGN="LEFT" PORT="R_garage_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_garage_name"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">garage_name</TD><TD ALIGN="LEFT" PORT="R_garage_name"><FONT COLOR="#526674">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_grid_address"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">grid_address</TD><TD ALIGN="LEFT" PORT="R_grid_address"><FONT COLOR="#526674">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_dispatch_phone"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">dispatch_phone</TD><TD ALIGN="LEFT" PORT="R_dispatch_phone"><FONT COLOR="#526674">varchar(30)</FONT></TD></TR></TABLE>>];
client [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>client</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_client_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="R_client_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_first_name"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="R_first_name"><FONT COLOR="#526674">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_last_name"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="R_last_name"><FONT COLOR="#526674">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_corporate_address"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">corporate_address</TD><TD ALIGN="LEFT" PORT="R_corporate_address"><FONT COLOR="#526674">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_phone"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="R_phone"><FONT COLOR="#526674">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_email"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="R_email"><FONT COLOR="#526674">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_license_token"><FONT COLOR="#22705b">UQ</FONT></TD><TD ALIGN="LEFT">license_token</TD><TD ALIGN="LEFT" PORT="R_license_token"><FONT COLOR="#526674">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_license_expiration"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">license_expiration</TD><TD ALIGN="LEFT" PORT="R_license_expiration"><FONT COLOR="#526674">date</FONT></TD></TR></TABLE>>];
deployment_manifest [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>deployment_manifest</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_serial_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">serial_id</TD><TD ALIGN="LEFT" PORT="R_serial_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_client_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="R_client_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_mech_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">mech_id</TD><TD ALIGN="LEFT" PORT="R_mech_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_departure_garage_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">departure_garage_id</TD><TD ALIGN="LEFT" PORT="R_departure_garage_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_return_garage_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">return_garage_id</TD><TD ALIGN="LEFT" PORT="R_return_garage_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_scheduled_start"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">scheduled_start</TD><TD ALIGN="LEFT" PORT="R_scheduled_start"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_scheduled_end"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">scheduled_end</TD><TD ALIGN="LEFT" PORT="R_scheduled_end"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_actual_start"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">actual_start ?</TD><TD ALIGN="LEFT" PORT="R_actual_start"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_actual_return"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">actual_return ?</TD><TD ALIGN="LEFT" PORT="R_actual_return"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_agreed_daily_rate"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">agreed_daily_rate</TD><TD ALIGN="LEFT" PORT="R_agreed_daily_rate"><FONT COLOR="#526674">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="R_status"><FONT COLOR="#526674">varchar(20)</FONT></TD></TR></TABLE>>];
maintenance_log [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>maintenance_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_log_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">log_id</TD><TD ALIGN="LEFT" PORT="R_log_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_reported_at"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">reported_at</TD><TD ALIGN="LEFT" PORT="R_reported_at"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_mech_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">mech_id</TD><TD ALIGN="LEFT" PORT="R_mech_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_reporting_client_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">reporting_client_id ?</TD><TD ALIGN="LEFT" PORT="R_reporting_client_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_issue_type"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">issue_type</TD><TD ALIGN="LEFT" PORT="R_issue_type"><FONT COLOR="#526674">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_description"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="R_description"><FONT COLOR="#526674">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="R_status"><FONT COLOR="#526674">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_scheduled_start"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">scheduled_start ?</TD><TD ALIGN="LEFT" PORT="R_scheduled_start"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_scheduled_end"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">scheduled_end ?</TD><TD ALIGN="LEFT" PORT="R_scheduled_end"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_resolved_at"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">resolved_at ?</TD><TD ALIGN="LEFT" PORT="R_resolved_at"><FONT COLOR="#526674">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_chief_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">chief_id ?</TD><TD ALIGN="LEFT" PORT="R_chief_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_engineering_notes"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">engineering_notes</TD><TD ALIGN="LEFT" PORT="R_engineering_notes"><FONT COLOR="#526674">text</FONT></TD></TR></TABLE>>];
manifest_charge [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>manifest_charge</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_serial_id"><FONT COLOR="#22705b">PK,FK</FONT></TD><TD ALIGN="LEFT">serial_id</TD><TD ALIGN="LEFT" PORT="R_serial_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_estimated_cost"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">estimated_cost</TD><TD ALIGN="LEFT" PORT="R_estimated_cost"><FONT COLOR="#526674">numeric(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_actual_cost"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">actual_cost ?</TD><TD ALIGN="LEFT" PORT="R_actual_cost"><FONT COLOR="#526674">numeric(14,2)</FONT></TD></TR></TABLE>>];
mech [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>mech</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_mech_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">mech_id</TD><TD ALIGN="LEFT" PORT="R_mech_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_chassis_serial"><FONT COLOR="#22705b">UQ</FONT></TD><TD ALIGN="LEFT">chassis_serial</TD><TD ALIGN="LEFT" PORT="R_chassis_serial"><FONT COLOR="#526674">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_manufacturer"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">manufacturer</TD><TD ALIGN="LEFT" PORT="R_manufacturer"><FONT COLOR="#526674">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_model"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT" PORT="R_model"><FONT COLOR="#526674">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_assembly_year"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">assembly_year</TD><TD ALIGN="LEFT" PORT="R_assembly_year"><FONT COLOR="#526674">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_armor_color"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">armor_color</TD><TD ALIGN="LEFT" PORT="R_armor_color"><FONT COLOR="#526674">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_daily_rate"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">daily_rate</TD><TD ALIGN="LEFT" PORT="R_daily_rate"><FONT COLOR="#526674">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_combat_hours"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">combat_hours</TD><TD ALIGN="LEFT" PORT="R_combat_hours"><FONT COLOR="#526674">numeric(16,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_type_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">type_id</TD><TD ALIGN="LEFT" PORT="R_type_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_garage_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">garage_id</TD><TD ALIGN="LEFT" PORT="R_garage_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_operational_status"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">operational_status</TD><TD ALIGN="LEFT" PORT="R_operational_status"><FONT COLOR="#526674">varchar(20)</FONT></TD></TR></TABLE>>];
mech_type [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>mech_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_type_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">type_id</TD><TD ALIGN="LEFT" PORT="R_type_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_type_name"><FONT COLOR="#22705b">UQ</FONT></TD><TD ALIGN="LEFT">type_name</TD><TD ALIGN="LEFT" PORT="R_type_name"><FONT COLOR="#526674">varchar(50)</FONT></TD></TR></TABLE>>];
pit_crew_technician [label=<<TABLE BORDER="1" COLOR="#a2b5bf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
 <TR><TD COLSPAN="3" BGCOLOR="#173b45"><FONT COLOR="white"><B>pit_crew_technician</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_staff_id"><FONT COLOR="#22705b">PK</FONT></TD><TD ALIGN="LEFT">staff_id</TD><TD ALIGN="LEFT" PORT="R_staff_id"><FONT COLOR="#526674">integer ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_garage_id"><FONT COLOR="#22705b">FK</FONT></TD><TD ALIGN="LEFT">garage_id</TD><TD ALIGN="LEFT" PORT="R_garage_id"><FONT COLOR="#526674">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_full_name"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT" PORT="R_full_name"><FONT COLOR="#526674">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_phone"><FONT COLOR="#22705b"> </FONT></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="R_phone"><FONT COLOR="#526674">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_corporate_email"><FONT COLOR="#22705b">UQ</FONT></TD><TD ALIGN="LEFT">corporate_email</TD><TD ALIGN="LEFT" PORT="R_corporate_email"><FONT COLOR="#526674">varchar(160)</FONT></TD></TR></TABLE>>];
battle_garage:R_garage_id:e -> deployment_manifest:L_departure_garage_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="1 : 0..N"];
battle_garage:R_garage_id:e -> deployment_manifest:L_return_garage_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="1 : 0..N"];
